---
import Frame from '../layouts/frame.astro';
import FriendCard from '../widgets/FriendCard.astro';

const breadcrumbs = [
  { text: 'Home', href: '/' },
  { text: 'Friends', href: '/friend' },
];

const friends = [
  {
    name: 'Alice Chen',
    site: 'rust-in-peace.dev',
    href: 'https://github.com',
    desc: 'Diving into Rust memory systems, OS dev, and asynchronous runtimes. Writes technical columns.',
    avatarText: 'A',
    avatarBg: 'rgba(0, 153, 204, 0.2)',
    avatarColor: 'var(--ny-color-outline)',
  },
  {
    name: 'Bob Gopher',
    site: 'gopherslog.org',
    href: 'https://github.com',
    desc: 'Go microservices architect, kubernetes wizard, and coffee lover. Sharing daily enterprise logs.',
    avatarText: 'B',
    avatarBg: 'rgba(0, 102, 204, 0.2)',
    avatarColor: '#00bfff',
  },
  {
    name: 'Charlie Pixel',
    site: 'pixelprose.design',
    href: 'https://github.com',
    desc: 'Designer, front-end visual engineer, and typographer. Creator of various dark high-end color schemes.',
    avatarText: 'C',
    avatarBg: 'rgba(0, 204, 102, 0.2)',
    avatarColor: '#00cc66',
  },
  {
    name: 'Diana Island',
    site: 'astroislands.net',
    href: 'https://github.com',
    desc: 'Web Components evangelist, Astro contributor, and clean semantics defender. Exploring islands paradigm.',
    avatarText: 'D',
    avatarBg: 'rgba(255, 102, 153, 0.2)',
    avatarColor: '#ff6699',
  },
  {
    name: 'Evan Evans',
    site: 'evan-notes.com',
    href: 'https://github.com',
    desc: 'Fullstack engineer writing about Go, Postgres optimization, and Docker orchestration tools.',
    avatarText: 'E',
    avatarBg: 'rgba(255, 51, 51, 0.2)',
    avatarColor: '#ff3333',
  },
];
---

<Frame title="Friends & Links - Nayuta Theme" breadcrumbs={breadcrumbs}>
  <div class="prose">
    <h1 class="page-title">Friends & Links</h1>
    <p>
      Here are some of my friends, classmates, and tech blogs that I follow
      regularly. Feel free to contact me if you would like to exchange website
      links!
    </p>

    <div class="friends-grid">
      {friends.map((friend) => <FriendCard {...friend} />)}
    </div>
  </div>
</Frame>
