---
import avatarImg from '../assets/images/avatar.png';
import Avatar from '../components/Avatar.astro';
import Button from '../components/Button.astro';
import config from '../config';
---

<div class="profile-card">
  <Avatar src={avatarImg.src} alt={`${config.author} Avatar`} />
  <div class="profile-info">
    <h2 class="profile-name">{config.author}</h2>
    <div class="profile-title">
      {config.description}
    </div>
  </div>

  <!-- Social Action Buttons -->
  <div class="social-buttons">
    <Button href="/posts">
      <svg viewBox="0 0 24 24">
        <path
          d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
        ></path>
      </svg>
      Posts
    </Button>
    <Button href="/friend">
      <svg viewBox="0 0 24 24">
        <path
          d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
        ></path>
      </svg>
      Friends
    </Button>
    <Button
      href="https://twitter.com/imotosae_anime"
      target="_blank"
      iconOnly={true}
      ariaLabel="Twitter / X"
    >
      <svg viewBox="0 0 24 24">
        <path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path>
      </svg>
    </Button>
    <Button
      href="https://imotosae.com"
      target="_blank"
      iconOnly={true}
      ariaLabel="Official GF Bunko / Imoutosae Portal"
    >
      <svg viewBox="0 0 24 24">
        <path
          d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
        ></path>
      </svg>
    </Button>
  </div>
</div>

<style>
  .profile-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .profile-name {
    font-size: 20px;
    font-weight: 700;
    color: var(--ny-color-text);
  }

  .profile-title {
    font-size: 11px;
    line-height: 1.4;
    color: var(--ny-color-text-muted);
  }

  .social-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
</style>
