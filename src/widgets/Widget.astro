---
interface Props {
  title: string;
  moreHref?: string;
  moreText?: string;
}

const { title, moreHref, moreText = 'More >' } = Astro.props;
---

<div class="widget">
  <div class="widget-header">
    <span>{title}</span>
    {moreHref && <a href={moreHref}>{moreText}</a>}
  </div>
  <slot />
</div>

<style>
  .widget {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .widget-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 12px;
    font-weight: 600;
    color: var(--ny-color-text-subtle);
    text-transform: capitalize;
    border-bottom: 1px solid var(--ny-color-border);
    padding-bottom: 6px;
    margin-bottom: 4px;
  }

  .widget-header a {
    font-size: 11px;
    color: var(--ny-color-text-subtle);
    text-decoration: none;
  }

  .widget-header a:hover {
    color: var(--ny-color-outline);
    text-decoration: underline;
  }
</style>
