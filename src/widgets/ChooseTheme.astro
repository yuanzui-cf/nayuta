---
import Widget from './Widget.astro';
---

<Widget title="Choose Theme">
  <div class="theme-swatches">
    <div
      class="theme-swatch active"
      style="background-color: #0099cc"
      title="Nayuta Aqua"
      data-theme-id=""
    >
    </div>
    <div
      class="theme-swatch"
      style="background-color: #0066cc"
      title="Midnight Blue"
      data-theme-id="midnight-blue"
    >
    </div>
    <div
      class="theme-swatch"
      style="background-color: #ff6699"
      title="Sakura Pink"
      data-theme-id="sakura-pink"
    >
    </div>
    <div
      class="theme-swatch"
      style="background-color: #333333"
      title="OLED Dark"
      data-theme-id="oled-dark"
    >
    </div>
  </div>
</Widget>

<script is:inline>
  // Run immediately to prevent Flash of Unstyled Content (FOUC)
  (function () {
    const savedTheme = localStorage.getItem('nayuta-theme') || '';
    if (savedTheme) {
      document.documentElement.setAttribute('data-theme', savedTheme);
    }
  })();
</script>

<script>
  function setupThemeSwitcher() {
    const swatches = document.querySelectorAll('.theme-swatch');

    function updateActiveSwatches(theme: string) {
      swatches.forEach((swatch) => {
        const themeId = swatch.getAttribute('data-theme-id') || '';
        if (themeId === theme) {
          swatch.classList.add('active');
        } else {
          swatch.classList.remove('active');
        }
      });
    }

    // Sync UI to current theme state
    const currentTheme = localStorage.getItem('nayuta-theme') || '';
    updateActiveSwatches(currentTheme);

    swatches.forEach((swatch) => {
      swatch.addEventListener('click', () => {
        const theme = swatch.getAttribute('data-theme-id') || '';
        if (theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('nayuta-theme', theme);
        } else {
          document.documentElement.removeAttribute('data-theme');
          localStorage.removeItem('nayuta-theme');
        }
        updateActiveSwatches(theme);
      });
    });
  }

  // Setup theme switcher on page load (and support Astro view transitions if added later)
  setupThemeSwitcher();
  document.addEventListener('astro:after-swap', setupThemeSwitcher);
</script>

<style>
  .theme-swatches {
    display: flex;
    gap: 8px;
  }

  .theme-swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid var(--ny-color-border);
    cursor: pointer;
    position: relative;
  }

  .theme-swatch.active::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    background-color: #fff;
    border-radius: 50%;
    top: 5px;
    left: 5px;
  }
</style>
