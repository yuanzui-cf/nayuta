---
import Input from '@layouts/components/Input.astro';
---

<form class="search-form" role="search" action="/search" method="get">
  <label>
    <span class="visually-hidden">Search articles</span>
    <Input type="search" name="q" placeholder="Search articles..." />
  </label>
</form>

<style>
  .search-form {
    min-width: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
