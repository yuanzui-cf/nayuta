---
import Widget from './Widget.astro';

interface Props {
  headings?: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;
const displayHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Widget title="Table of Contents">
  <div class="widget-content-simple">
    {
      displayHeadings.length > 0 ? (
        displayHeadings.map((h) => (
          <div
            style={`padding-left: ${(h.depth - 2) * 12}px; margin-bottom: 6px;`}
          >
            <a href={`#${h.slug}`} class="toc-link">
              {h.text}
            </a>
          </div>
        ))
      ) : (
        <div class="empty-toc">No headings on this page</div>
      )
    }
  </div>
</Widget>

<style>
  .widget-content-simple {
    font-size: 12px;
    color: var(--ny-color-text-muted);
    line-height: 1.7;
  }

  .toc-link {
    color: var(--ny-color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--ny-color-outline);
    text-decoration: underline;
  }

  .empty-toc {
    font-style: italic;
    color: var(--ny-color-text-subtle);
  }
</style>
