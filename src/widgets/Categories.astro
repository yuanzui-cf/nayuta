---
import Widget from './Widget.astro';

const categories = [
  { name: 'Technical Notes', count: 12 },
  { name: 'Ramblings', count: 8 },
  { name: 'Design Systems', count: 5 },
];
---

<Widget title="Categories">
  <div class="status-list">
    {
      categories.map((cat) => (
        <div class="status-row">
          <span class="status-label">{cat.name}</span>
          <span class="status-value">({cat.count})</span>
        </div>
      ))
    }
  </div>
</Widget>

<style>
  .status-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .status-row {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    line-height: 1.6;
  }

  .status-label {
    color: var(--ny-color-text-muted);
  }

  .status-value {
    color: var(--ny-color-text);
    font-weight: 500;
  }
</style>
