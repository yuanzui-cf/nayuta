---
import config from '../config';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const currentYear = new Date().getFullYear();
const configuredSince = config.since ?? config.site_start_date;
const sinceYear = configuredSince
  ? new Date(configuredSince).getFullYear()
  : undefined;
const copyrightYears =
  sinceYear !== undefined &&
  Number.isFinite(sinceYear) &&
  sinceYear !== currentYear
    ? `${sinceYear}-${currentYear}`
    : `${currentYear}`;
---

<footer class={className}>
  <p>Copyright &copy; {copyrightYears} {config.author}. All rights reserved.</p>
  <p>
    Powered by <a href="https://github.com/yuanzui-cf/nayuta">Nayuta</a>.
    Designed by <a href="https://yzcf.top">Leo Jia</a>.
  </p>
</footer>
