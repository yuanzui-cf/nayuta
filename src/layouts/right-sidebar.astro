---
interface Props {
  drawer?: boolean;
}

const { drawer = false } = Astro.props;
---

{
  drawer ? (
    <div class="right-sidebar-content right-sidebar-content-drawer">
      <slot />
    </div>
  ) : (
    <aside class="right-region" id="right-sidebar">
      <div class="right-sidebar-content">
        <slot />
      </div>
    </aside>
  )
}

<style>
  .right-sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
</style>
