---
import config from '../config';

interface Props {
  title: string;
}

const { title } = Astro.props;

const rawThemeName = config.theme || 'nayuta-aqua';
const themeBaseName = rawThemeName.replace(/\.css$/, '');
const themeFileName = `${themeBaseName}.css`;

const themeLoaders = import.meta.glob('/src/styles/themes/*.css', {
  query: '?raw',
  import: 'default',
});

const themePath = `/src/styles/themes/${themeFileName}`;
const loadTheme = themeLoaders[themePath];

if (!loadTheme) {
  const availableThemes = Object.keys(themeLoaders)
    .map((p) => p.replace('/src/styles/themes/', '').replace(/\.css$/, ''))
    .join(', ');
  throw new Error(
    `Theme "${themeBaseName}" not found in src/styles/themes/. Available themes: ${availableThemes}`,
  );
}

const themeCss = (await loadTheme()) as string;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/png" href="/favicon.png" />
<title>{title}</title>
<meta name="description" content="" />
<meta name="keywords" content="" />
<meta name="author" content="" />

<style is:global set:html={themeCss}></style>
