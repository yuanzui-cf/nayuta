---
import config from '../config';

interface Props {
  title?: string;
  isHome?: boolean;
}

const { title, isHome = false } = Astro.props;

// Format page title:
// - Home page: directly config.title
// - Other pages: `${pageTitle} - ${config.title}`
let formattedTitle = config.title;
if (!isHome && title && title !== config.title) {
  if (title.endsWith(` - ${config.title}`)) {
    formattedTitle = title;
  } else {
    formattedTitle = `${title} - ${config.title}`;
  }
}

const rawThemeName = config.theme || 'nayuta-aqua';
const themeBaseName = rawThemeName.replace(/\.css$/, '');
const themeFileName = `${themeBaseName}.css`;

const themeLoaders = import.meta.glob('/src/styles/themes/*.css', {
  query: '?raw',
  import: 'default',
});

const themePath = `/src/styles/themes/${themeFileName}`;
const loadTheme = themeLoaders[themePath];

if (!loadTheme) {
  const availableThemes = Object.keys(themeLoaders)
    .map((p) => p.replace('/src/styles/themes/', '').replace(/\.css$/, ''))
    .join(', ');
  throw new Error(
    `Theme "${themeBaseName}" not found in src/styles/themes/. Available themes: ${availableThemes}`,
  );
}

const themeCss = (await loadTheme()) as string;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/png" href="/favicon.png" />
<title>{formattedTitle}</title>
<meta name="description" content={config.description || ''} />
<meta name="author" content={config.author || ''} />

<!-- Built-in Icon Library (Font Awesome) -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
/>

<style is:global set:html={themeCss}></style>
