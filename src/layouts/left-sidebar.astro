---
import config from '../config';
---

<aside class="left-region" id="left-sidebar">
  <header class="left-header">
    <slot name="header" />
  </header>

  <div class="left-sidebar-content">
    <slot />
  </div>

  <footer class="left-footer">
    <p>Copyright (C) 2026 {config.title}. All rights reserved.</p>
    <p>
      Powered by <a href="https://github.com/yuanzui-cf/nayuta">Nayuta</a>.
      Designed by <a href="https://yzcf.top">Leo Jia</a>.
    </p>
  </footer>
</aside>

<style>
  .left-region {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .left-sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
</style>
