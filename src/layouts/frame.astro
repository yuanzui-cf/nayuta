---
import HeadBase from "./head-base.astro";
import Header from "./header.astro";

import logo from "../assets/images/favicon.jpg"

interface Props {
    title: string;
}
---

<!doctype html>
<html lang="zh-Hans">
    <head>
        <HeadBase title={Astro.props.title} />
        <slot name="head" />
    </head>
    <body>
        <Header favicon={logo} />
        <slot />
    </body>
</html>

<style is:global>
    * {
        margin: 0;
        padding: 0;
    }
</style>

<style>
    html,
    body {
        width: 100%;
        min-height: 100vh;
        min-height: 100dvh;
        padding: 0;
        margin: 0;
    }

    body {
        box-sizing: border-box;
        max-width: 1920px;
        padding: 60px 30px;
        margin: auto;
        display: flex;
        gap: 10px;

        // TODO: Remove these
        background-color: #faf8f0;
        color: #120e01;
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            Oxygen,
            Ubuntu,
            Cantarell,
            "Open Sans",
            "Helvetica Neue",
            sans-serif;
    }
</style>
