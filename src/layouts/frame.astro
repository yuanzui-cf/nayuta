---
import HeadBase from './head-base.astro';
import LeftSidebar from '../widgets/LeftSidebar.astro';
import TableOfContents from '../widgets/TableOfContents.astro';
import '../styles/global.css';

interface Props {
  title: string;
  withRightSidebar?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  breadcrumbs?: { text: string; href: string }[];
}

const {
  title,
  withRightSidebar = false,
  headings = [],
  breadcrumbs = [{ text: 'Home', href: '/' }],
} = Astro.props;

const hasRightSidebar = withRightSidebar || headings.length > 0;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <HeadBase title={title} />
    <slot name="head" />
  </head>
  <body>
    <!-- Mobile Sticky Header -->
    <header class="mobile-sticky-header">
      <nav class="breadcrumbs">
        {
          breadcrumbs.map((crumb, idx) => (
            <Fragment key={crumb.href}>
              <a href={crumb.href}>{crumb.text}</a>
              {idx < breadcrumbs.length && ' > '}
            </Fragment>
          ))
        }
      </nav>
      <div class="header-actions">
        <button
          class="header-action-btn"
          id="open-widgets-btn"
          aria-label="Open Widgets"
        >
          <svg viewBox="0 0 24 24">
            <path
              d="M4 4h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 10h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 16h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4z"
            ></path>
          </svg>
        </button>
        {
          hasRightSidebar && (
            <button
              class="header-action-btn"
              id="open-context-btn"
              aria-label="Open Page Widgets"
            >
              <svg viewBox="0 0 24 24">
                <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
              </svg>
            </button>
          )
        }
      </div>
    </header>

    <div
      class={`layout-container ${hasRightSidebar ? 'with-right-sidebar' : ''}`}
    >
      <!-- Left Region (Sidebar) -->
      <aside class="left-region" id="left-sidebar">
        <LeftSidebar />
        <!-- Desktop Footer -->
        <footer class="left-footer">
          <p>Copyright (C) 2025 Leo Jia. All rights reserved.</p>
          <p>
            Powered by <a href="#">Litepage</a>. Designed by <a href="#"
              >Leo Jia</a
            >.
          </p>
        </footer>
      </aside>

      <!-- Main Region -->
      <main class="main-region">
        <nav class="breadcrumbs">
          {
            breadcrumbs.map((crumb, idx) => (
              <Fragment key={crumb.href}>
                <a href={crumb.href}>{crumb.text}</a>
                {idx < breadcrumbs.length && ' > '}
              </Fragment>
            ))
          }
        </nav>

        <slot />

        <!-- Mobile Footer (Shown in normal flow only on mobile) -->
        <footer class="mobile-footer">
          <p>Copyright (C) 2025 Leo Jia. All rights reserved.</p>
          <p>
            Powered by <a href="#">Litepage</a>. Designed by <a href="#"
              >Leo Jia</a
            >.
          </p>
        </footer>
      </main>

      <!-- Right Region (Sidebar) -->
      {
        hasRightSidebar && (
          <aside class="right-region" id="right-sidebar">
            {headings.length > 0 ? (
              <TableOfContents headings={headings} />
            ) : (
              <slot name="right" />
            )}
          </aside>
        )
      }
    </div>

    <!-- Mobile Drawer Elements -->
    <div class="drawer-backdrop" id="drawer-backdrop"></div>

    <!-- Left Drawer (Widgets) -->
    <div class="drawer" id="widgets-drawer">
      <button class="drawer-close" id="close-widgets-btn">[Close]</button>
      <div style="margin-top: 20px;">
        <LeftSidebar />
      </div>
    </div>

    <!-- Right Drawer (Context) -->
    {
      hasRightSidebar && (
        <div class="drawer drawer-right" id="context-drawer">
          <button class="drawer-close" id="close-context-btn">
            [Close]
          </button>
          <div style="margin-top: 20px;">
            {headings.length > 0 ? (
              <TableOfContents headings={headings} />
            ) : (
              <slot name="right" />
            )}
          </div>
        </div>
      )
    }

    <!-- Pure JS for drawer transitions (Progressive Enhancement) -->
    <script>
      function setupDrawers() {
        const openBtn = document.getElementById('open-widgets-btn');
        const closeBtn = document.getElementById('close-widgets-btn');
        const openContextBtn = document.getElementById('open-context-btn');
        const closeContextBtn = document.getElementById('close-context-btn');

        const widgetsDrawer = document.getElementById('widgets-drawer');
        const contextDrawer = document.getElementById('context-drawer');
        const backdrop = document.getElementById('drawer-backdrop');

        function toggleWidgetsDrawer(open: boolean) {
          if (!widgetsDrawer || !backdrop) return;
          if (open) {
            widgetsDrawer.classList.add('open');
            backdrop.classList.add('open');
          } else {
            widgetsDrawer.classList.remove('open');
            backdrop.classList.remove('open');
          }
        }

        function toggleContextDrawer(open: boolean) {
          if (!contextDrawer || !backdrop) return;
          if (open) {
            contextDrawer.classList.add('open');
            backdrop.classList.add('open');
          } else {
            contextDrawer.classList.remove('open');
            backdrop.classList.remove('open');
          }
        }

        function closeAll() {
          toggleWidgetsDrawer(false);
          toggleContextDrawer(false);
        }

        if (openBtn) {
          openBtn.addEventListener('click', () => {
            closeAll();
            toggleWidgetsDrawer(true);
          });
        }
        if (closeBtn) {
          closeBtn.addEventListener('click', () => toggleWidgetsDrawer(false));
        }

        if (openContextBtn) {
          openContextBtn.addEventListener('click', () => {
            closeAll();
            toggleContextDrawer(true);
          });
        }
        if (closeContextBtn) {
          closeContextBtn.addEventListener('click', () =>
            toggleContextDrawer(false),
          );
        }

        if (backdrop) {
          backdrop.addEventListener('click', closeAll);
        }

        // Close on Escape key
        const escHandler = (e: KeyboardEvent) => {
          if (e.key === 'Escape') {
            closeAll();
          }
        };
        document.removeEventListener('keydown', escHandler);
        document.addEventListener('keydown', escHandler);
      }

      setupDrawers();
      // Support Astro View Transitions if swap occurs
      document.addEventListener('astro:after-swap', setupDrawers);
    </script>
  </body>
</html>
