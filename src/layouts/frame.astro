---
import HeadBase from './head-base.astro';
import LeftSidebar from '../widgets/LeftSidebar.astro';
import TableOfContents from '../widgets/TableOfContents.astro';
import '../styles/global.css';

interface Props {
  title: string;
  withRightSidebar?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  breadcrumbs?: { text: string; href: string }[];
}

const {
  title,
  withRightSidebar = false,
  headings = [],
  breadcrumbs = [{ text: 'Home', href: '/' }],
} = Astro.props;

const hasRightSidebar = withRightSidebar || headings.length > 0;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <HeadBase title={title} />
    <slot name="head" />
  </head>
  <body>
    <!-- Mobile Sticky Header -->
    <header class="mobile-sticky-header">
      <nav class="breadcrumbs">
        {
          breadcrumbs.map((crumb, idx) => (
            <Fragment key={crumb.href}>
              <a href={crumb.href}>{crumb.text}</a>
              {idx < breadcrumbs.length && ' > '}
            </Fragment>
          ))
        }
      </nav>
      <div class="header-actions">
        <button
          class="header-action-btn"
          id="open-widgets-btn"
          aria-label="Open Widgets"
        >
          <svg viewBox="0 0 24 24">
            <path
              d="M4 4h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 10h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4zM4 16h4v4H4zm6 0h4v4h-4zm6 0h4v4h-4z"
            ></path>
          </svg>
        </button>
        {
          hasRightSidebar && (
            <button
              class="header-action-btn"
              id="open-context-btn"
              aria-label="Open Page Widgets"
            >
              <svg viewBox="0 0 24 24">
                <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
              </svg>
            </button>
          )
        }
      </div>
    </header>

    <div
      class={`layout-container ${hasRightSidebar ? 'with-right-sidebar' : ''}`}
    >
      <!-- Left Region (Sidebar) -->
      <aside class="left-region" id="left-sidebar">
        <LeftSidebar />
        <!-- Desktop Footer -->
        <footer class="left-footer">
          <p>Copyright (C) 2025 Leo Jia. All rights reserved.</p>
          <p>
            Powered by <a href="#">Litepage</a>. Designed by <a href="#"
              >Leo Jia</a
            >.
          </p>
        </footer>
      </aside>

      <!-- Main Region -->
      <main class="main-region">
        <nav class="breadcrumbs">
          {
            breadcrumbs.map((crumb, idx) => (
              <Fragment key={crumb.href}>
                <a href={crumb.href}>{crumb.text}</a>
                {idx < breadcrumbs.length && ' > '}
              </Fragment>
            ))
          }
        </nav>

        <slot />

        <!-- Mobile Footer (Shown in normal flow only on mobile) -->
        <footer class="mobile-footer">
          <p>Copyright (C) 2025 Leo Jia. All rights reserved.</p>
          <p>
            Powered by <a href="#">Litepage</a>. Designed by <a href="#"
              >Leo Jia</a
            >.
          </p>
        </footer>
      </main>

      <!-- Right Region (Sidebar) -->
      {
        hasRightSidebar && (
          <aside class="right-region" id="right-sidebar">
            {headings.length > 0 ? (
              <TableOfContents headings={headings} />
            ) : (
              <slot name="right" />
            )}
          </aside>
        )
      }
    </div>

    <!-- Mobile Drawer Elements -->
    <div class="drawer-backdrop" id="drawer-backdrop"></div>

    <!-- Left Drawer (Widgets) -->
    <div class="drawer" id="widgets-drawer">
      <button class="drawer-close" id="close-widgets-btn">[Close]</button>
      <div style="margin-top: 20px;">
        <LeftSidebar />
      </div>
    </div>

    <!-- Right Drawer (Context) -->
    {
      hasRightSidebar && (
        <div class="drawer drawer-right" id="context-drawer">
          <button class="drawer-close" id="close-context-btn">
            [Close]
          </button>
          <div style="margin-top: 20px;">
            {headings.length > 0 ? (
              <TableOfContents headings={headings} />
            ) : (
              <slot name="right" />
            )}
          </div>
        </div>
      )
    }

    <!-- Pure JS for drawer transitions (Progressive Enhancement) -->
    <script>
      function setupDrawers() {
        const openBtn = document.getElementById('open-widgets-btn');
        const closeBtn = document.getElementById('close-widgets-btn');
        const openContextBtn = document.getElementById('open-context-btn');
        const closeContextBtn = document.getElementById('close-context-btn');

        const widgetsDrawer = document.getElementById('widgets-drawer');
        const contextDrawer = document.getElementById('context-drawer');
        const backdrop = document.getElementById('drawer-backdrop');

        function toggleWidgetsDrawer(open: boolean) {
          if (!widgetsDrawer || !backdrop) return;
          if (open) {
            widgetsDrawer.classList.add('open');
            backdrop.classList.add('open');
          } else {
            widgetsDrawer.classList.remove('open');
            backdrop.classList.remove('open');
          }
        }

        function toggleContextDrawer(open: boolean) {
          if (!contextDrawer || !backdrop) return;
          if (open) {
            contextDrawer.classList.add('open');
            backdrop.classList.add('open');
          } else {
            contextDrawer.classList.remove('open');
            backdrop.classList.remove('open');
          }
        }

        function closeAll() {
          toggleWidgetsDrawer(false);
          toggleContextDrawer(false);
        }

        if (openBtn) {
          openBtn.addEventListener('click', () => {
            closeAll();
            toggleWidgetsDrawer(true);
          });
        }
        if (closeBtn) {
          closeBtn.addEventListener('click', () => toggleWidgetsDrawer(false));
        }

        if (openContextBtn) {
          openContextBtn.addEventListener('click', () => {
            closeAll();
            toggleContextDrawer(true);
          });
        }
        if (closeContextBtn) {
          closeContextBtn.addEventListener('click', () =>
            toggleContextDrawer(false),
          );
        }

        if (backdrop) {
          backdrop.addEventListener('click', closeAll);
        }

        // Close on Escape key
        const escHandler = (e: KeyboardEvent) => {
          if (e.key === 'Escape') {
            closeAll();
          }
        };
        document.removeEventListener('keydown', escHandler);
        document.addEventListener('keydown', escHandler);
      }

      setupDrawers();
      // Support Astro View Transitions if swap occurs
      document.addEventListener('astro:after-swap', setupDrawers);
    </script>
  </body>
</html>

<style>
  .layout-container {
    display: grid;
    grid-template-columns: var(--ny-layout-left-width) minmax(0, 1fr);
    gap: var(--ny-layout-column-gap);
    max-width: calc(
      var(--ny-layout-page-max-width) + var(--ny-layout-column-gap) + 2 *
        var(--ny-layout-outer-padding-inline)
    );
    margin: 0 auto;
    padding: var(--ny-layout-outer-padding-block)
      var(--ny-layout-outer-padding-inline);
    min-height: 100vh;
  }

  .layout-container.with-right-sidebar {
    grid-template-columns: var(--ny-layout-left-width) minmax(0, 1fr) var(
        --ny-layout-right-width
      );
    max-width: calc(
      var(--ny-layout-page-max-width) + 2 * var(--ny-layout-column-gap) + 2 *
        var(--ny-layout-outer-padding-inline)
    );
  }

  .left-region {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: sticky;
    top: var(--ny-layout-outer-padding-block);
    max-height: calc(100vh - 2 * var(--ny-layout-outer-padding-block));
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--ny-color-border) transparent;
    padding-right: 6px;
  }

  .left-region::-webkit-scrollbar {
    width: 4px;
  }

  .left-region::-webkit-scrollbar-track {
    background: transparent;
  }

  .left-region::-webkit-scrollbar-thumb {
    background: var(--ny-color-border);
    border-radius: var(--ny-radius-xs);
  }

  .left-region::-webkit-scrollbar-thumb:hover {
    background: var(--ny-color-outline);
  }

  .left-footer {
    margin-top: auto;
    font-size: 10px;
    color: var(--ny-color-text-subtle);
    line-height: 1.6;
    border-top: 1px solid var(--ny-color-border);
    padding-top: 16px;
  }

  .left-footer a,
  .mobile-footer a {
    color: var(--ny-color-text-muted);
    text-decoration: none;
  }

  .left-footer a:hover,
  .mobile-footer a:hover {
    color: var(--ny-color-outline);
    text-decoration: underline;
  }

  .main-region {
    max-width: 1670px;
    width: 100%;
  }

  .layout-container.with-right-sidebar .main-region {
    max-width: 1470px;
  }

  .breadcrumbs {
    font-size: 11px;
    color: var(--ny-color-text-subtle);
    margin-bottom: 24px;
  }

  .breadcrumbs a {
    color: var(--ny-color-text-subtle);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--ny-color-outline);
  }

  .right-region {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: fit-content;
    position: sticky;
    top: var(--ny-layout-outer-padding-block);
  }

  .mobile-sticky-header {
    display: none;
  }

  .drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    width: min(300px, calc(100vw - 32px));
    background-color: var(--ny-color-surface);
    border-right: 1px solid var(--ny-color-border);
    padding: 24px;
    box-shadow: 10px 0 30px var(--ny-color-shadow);
    z-index: 2000;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
  }

  .drawer-right {
    left: auto;
    right: 0;
    border-right: none;
    border-left: 1px solid var(--ny-color-border);
    transform: translateX(100%);
  }

  .drawer.open {
    transform: translateX(0);
  }

  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 13, 22, 0.8);
    backdrop-filter: blur(4px);
    z-index: 1500;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: var(--ny-color-text-muted);
    font-family: var(--ny-font-ui);
    font-size: 14px;
    cursor: pointer;
  }

  .drawer-close + div {
    margin-top: 44px !important;
  }

  .drawer-close:hover {
    color: var(--ny-color-outline);
  }

  @media (max-width: 1120px) {
    .layout-container.with-right-sidebar {
      grid-template-columns: var(--ny-layout-left-width) minmax(0, 1fr);
    }

    .layout-container.with-right-sidebar .main-region {
      max-width: 1670px;
    }

    .right-region {
      display: none;
    }

    .mobile-sticky-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      height: 48px;
      background-color: rgba(3, 13, 22, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--ny-color-border);
      padding: 0 20px;
      z-index: 1000;
    }

    .mobile-sticky-header .breadcrumbs {
      margin-bottom: 0;
    }

    .header-actions {
      display: flex;
      gap: 8px;
    }

    .header-action-btn {
      background: none;
      border: 1px solid var(--ny-color-border);
      border-radius: var(--ny-radius-sm);
      color: var(--ny-color-text-muted);
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .header-action-btn:hover {
      color: var(--ny-color-outline);
      border-color: var(--ny-color-outline);
      background-color: var(--ny-color-surface-container);
    }

    .header-action-btn svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
    }

    .main-region .breadcrumbs {
      display: none;
    }

    #open-widgets-btn {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .layout-container {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 20px;
      row-gap: 16px;
      align-content: start;
    }

    .layout-container.with-right-sidebar {
      grid-template-columns: minmax(0, 1fr);
    }

    .left-region,
    .main-region {
      display: contents;
    }

    .left-region :global(.widget),
    .left-region .left-footer {
      display: none;
    }

    .breadcrumbs {
      grid-row: 1;
      margin-bottom: 0;
    }

    .left-region :global(.profile-card) {
      grid-row: 2;
      border-bottom: 1px solid var(--ny-color-border);
      padding-bottom: 20px;
      margin-bottom: 8px;
    }

    .main-region :global(.prose) {
      grid-row: 3;
    }

    .mobile-footer {
      grid-row: 4;
      display: block;
      margin-top: 40px;
      padding-top: 16px;
      border-top: 1px solid var(--ny-color-border);
      font-size: 10px;
      color: var(--ny-color-text-subtle);
      line-height: 1.6;
    }

    #open-widgets-btn {
      display: flex;
    }
  }

  @media (min-width: 769px) {
    .mobile-footer {
      display: none;
    }
  }
</style>
