---
import Image from '@layouts/components/Image.astro';
import type { CollectionEntry } from 'astro:content';
import Badge from '@layouts/components/Badge.astro';
import type { PostSummaryData } from '@type/post-list';
import { formatReadingTime } from '@assets/utils/reading-time';

interface Props {
  item?: Omit<PostSummaryData, 'cover'>;
  cover?: CollectionEntry<'posts'>['data']['cover'];
}

const { item, cover } = Astro.props;
// With no item this is the single inert template used by the browser renderer.
const template = !item;
---

<article class="post-summary">
  {
    (cover || template) && (
      <div class="post-cover-container">
        <Image
          class="post-cover"
          src={cover}
          alt={item?.title ?? ''}
          ratio="16 / 9"
          lightbox={false}
        />
      </div>
    )
  }
  <h2 class="post-title">
    {(item?.draft || template) && <Badge variant="draft">Draft</Badge>}
    <a href={item?.href}>{item?.title}</a>
  </h2>
  <div class="post-meta">
    <span data-published>Published: {item?.publishDate}</span>
    <span data-reading
      >Reading: {item && formatReadingTime(item.readingTimeMinutes)}</span
    >
  </div>
  {
    (item?.description || template) && (
      <p class="post-description">{item?.description}</p>
    )
  }
</article>

<style>
  .post-summary {
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--ny-color-border);
    padding-bottom: var(--ny-space-6);
    display: flex;
    flex-direction: column;
    gap: calc(var(--ny-space-3) / 2);
  }

  .post-summary:last-child {
    border-bottom: 0;
  }

  .post-summary :global(mark) {
    background: var(--ny-color-primary);
    color: var(--ny-color-primary-text);
  }

  :global(.post-list) .post-title {
    --ny-badge-font-size: var(--ny-font-size-ui-small);

    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ny-space-2);
    font-size: var(--ny-font-size-heading);
    line-height: var(--ny-line-height-heading);
    font-weight: 700;
    border-bottom: 0 !important;
    margin-top: 0 !important;
    margin-bottom: var(--ny-space-1);
  }

  :global(.post-list) .post-title a {
    color: var(--ny-color-text);
    text-decoration: none;
  }

  :global(.post-list) .post-title a:hover {
    color: var(--ny-color-outline);
    text-decoration: underline;
  }

  .post-meta {
    font-size: var(--ny-font-size-meta);
    line-height: var(--ny-line-height-compact);
    color: var(--ny-color-text-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: var(--ny-space-1) var(--ny-space-4);
  }

  .post-cover-container {
    width: 100%;
    border-radius: var(--ny-radius-md);
    overflow: hidden;
    border: 1px solid var(--ny-color-border);
    aspect-ratio: 16 / 9;
    margin-bottom: var(--ny-space-3);
    background-color: var(--ny-color-surface-container);
  }

  .post-cover-container :global(nayuta-image) {
    display: block;
    width: 100%;
    border: none;
    border-radius: 0;
  }

  .post-cover-container :global(.post-cover) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    border: none;
    border-radius: 0;
  }

  :global(.post-list) .post-description {
    color: var(--ny-color-text-muted);
    font-size: var(--ny-font-size-prose);
    line-height: var(--ny-line-height-prose);
    margin-top: var(--ny-space-2);
    margin-bottom: 0;
  }
</style>
