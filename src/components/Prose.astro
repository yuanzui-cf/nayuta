---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`prose ${className}`.trim()}>
  <slot />
</div>

<style>
  .prose {
    font-family: var(--ny-font-prose);
    color: var(--ny-color-text);
    font-size: 13px;
    line-height: 1.7;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }

  .prose :global(h1.page-title) {
    font-size: 26px;
    font-weight: 700;
    color: var(--ny-color-text);
    margin-bottom: 24px;
    line-height: 1.2;
  }

  .prose :global(p) {
    margin-bottom: 18px;
  }

  .prose :global(a) {
    color: var(--ny-color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .prose :global(a:hover) {
    color: var(--ny-color-outline);
  }

  .prose :global(h2) {
    font-size: 18px;
    font-weight: 700;
    color: var(--ny-color-text);
    margin-top: 32px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--ny-color-border);
    padding-bottom: 6px;
  }

  .prose :global(h3) {
    font-size: 15px;
    font-weight: 600;
    color: var(--ny-color-text);
    margin-top: 24px;
    margin-bottom: 8px;
  }

  .prose :global(h4) {
    font-size: 13px;
    font-weight: 600;
    color: var(--ny-color-text);
    margin-top: 18px;
    margin-bottom: 6px;
  }

  .prose :global(h5) {
    font-size: 12px;
    font-weight: 600;
    color: var(--ny-color-text-muted);
    margin-top: 16px;
    margin-bottom: 6px;
  }

  .prose :global(h6) {
    font-size: 11px;
    font-weight: 600;
    color: var(--ny-color-text-subtle);
    margin-top: 16px;
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--ny-color-primary);
    padding-left: var(--ny-space-3);
    color: var(--ny-color-text-muted);
    font-style: italic;
    margin: var(--ny-space-4) 0;
    background-color: rgba(0, 153, 204, 0.02);
    padding-block: 4px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--ny-space-4);
    padding-left: 20px;
  }

  .prose :global(ul) {
    list-style-type: square;
  }

  .prose :global(ol) {
    list-style-type: decimal;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(li::marker) {
    color: var(--ny-color-outline);
  }

  .prose :global(li.task-list-item) {
    list-style-type: none;
    padding-left: 0;
    margin-left: -20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .prose :global(input[type='checkbox']) {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border: 1px solid var(--ny-color-text-subtle);
    border-radius: var(--ny-radius-xs);
    background-color: var(--ny-color-surface-container);
    outline: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
    vertical-align: middle;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .prose :global(input[type='checkbox']:hover:not(:disabled)) {
    border-color: var(--ny-color-outline);
    background-color: var(--ny-color-surface-elevated);
  }

  .prose :global(input[type='checkbox']:checked) {
    background-color: var(--ny-color-primary);
    border-color: var(--ny-color-outline);
  }

  .prose :global(input[type='checkbox']:checked::after) {
    content: '';
    position: absolute;
    width: 3px;
    height: 6px;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    top: 1px;
    left: 4px;
  }

  .prose :global(input[type='checkbox']:disabled) {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .prose :global(input[type='checkbox']:disabled:checked) {
    background-color: var(--ny-color-primary-active);
    border-color: var(--ny-color-outline);
  }

  .prose :global(input[type='checkbox']:disabled:checked::after) {
    border-color: #ffffff;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--ny-color-border);
    margin: 32px 0;
  }

  .prose :global(figure) {
    margin: var(--ny-space-5) 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--ny-radius-md);
    border: 1px solid var(--ny-color-border);
    background-color: var(--ny-color-surface-container);
  }

  .prose :global(figcaption) {
    font-size: 11px;
    color: var(--ny-color-text-subtle);
    text-align: center;
    font-style: italic;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    font-size: 12px;
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--ny-color-border);
    border-right: 1px solid var(--ny-color-border);
    padding: 8px 12px;
    text-align: left;
  }

  .prose :global(th:last-child),
  .prose :global(td:last-child) {
    border-right: none;
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(th) {
    background-color: var(--ny-color-surface-elevated);
    border-top: none;
    font-weight: 600;
  }

  .prose :global(kbd) {
    font-family: var(--ny-font-code);
    background-color: var(--ny-color-surface-elevated);
    border: 1px solid var(--ny-color-border);
    border-radius: var(--ny-radius-xs);
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    color: var(--ny-color-text);
    display: inline-block;
    font-size: 11px;
    line-height: 1.4;
    margin: 0 0.1em;
    padding: 0.15em 0.6em;
    white-space: nowrap;
  }

  .prose :global(dl) {
    margin-bottom: var(--ny-space-4);
  }

  .prose :global(dt) {
    font-weight: 700;
    margin-top: var(--ny-space-3);
    color: var(--ny-color-outline);
  }

  .prose :global(dd) {
    padding-left: var(--ny-space-4);
    margin-bottom: var(--ny-space-2);
    color: var(--ny-color-text-muted);
  }

  .prose :global(pre) {
    background-color: var(--ny-color-surface-container);
    border: 1px solid var(--ny-color-border);
    border-radius: var(--ny-radius-md);
    padding: var(--ny-space-3);
    overflow-x: auto;
    max-width: 100%;
    width: 100%;
    margin: var(--ny-space-4) 0;
    font-family: var(--ny-font-code);
    font-size: 12px;
    line-height: 1.5;
    -webkit-overflow-scrolling: touch;
  }

  .prose :global(code) {
    font-family: var(--ny-font-code);
    background-color: var(--ny-color-surface-container);
    padding: 2px 4px;
    border-radius: var(--ny-radius-xs);
    color: var(--ny-color-outline);
  }

  .prose :global(pre code) {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
    color: inherit;
  }

  .prose :global(.post-subtitle) {
    font-weight: 700;
    margin-top: 24px;
    margin-bottom: 12px;
  }

  .prose :global(.post-heading-huge) {
    font-size: 40px;
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
    margin-top: 32px;
    margin-bottom: 24px;
    letter-spacing: -0.03em;
    word-wrap: break-word;
    color: var(--ny-color-text);
  }
</style>
