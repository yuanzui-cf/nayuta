---
interface Props {
  type: 'note' | 'tip' | 'important' | 'warning' | 'caution';
  title?: string;
  class?: string;
}

const { type, title, class: className = '' } = Astro.props;

const defaultTitles = {
  note: '📝 Note',
  tip: '💡 Tip',
  important: '⚠️ Important',
  warning: '⚡ Warning',
  caution: '🛑 Caution',
};

const displayTitle = title || defaultTitles[type] || type.toUpperCase();
---

<div class={`callout callout-${type} ${className}`.trim()}>
  <div class="callout-title">{displayTitle}</div>
  <slot />
</div>

<style>
  .callout {
    padding: var(--ny-space-3) var(--ny-space-4);
    border-radius: 0 var(--ny-radius-md) var(--ny-radius-md) 0;
    margin: var(--ny-space-4) 0;
    border-left: 4px solid var(--ny-color-border);
    font-size: 12px;
  }

  .callout :global(p:last-child) {
    margin-bottom: 0;
  }

  .callout-title {
    font-weight: 700;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    font-size: 10px;
  }

  .callout-note {
    background-color: rgba(0, 153, 204, 0.05);
    border-left-color: var(--ny-color-primary);
  }

  .callout-note .callout-title {
    color: var(--ny-color-outline);
  }

  .callout-tip {
    background-color: rgba(0, 204, 102, 0.05);
    border-left-color: #00cc66;
  }

  .callout-tip .callout-title {
    color: #00cc66;
  }

  .callout-important {
    background-color: rgba(0, 191, 255, 0.05);
    border-left-color: var(--ny-color-outline);
  }

  .callout-important .callout-title {
    color: var(--ny-color-outline);
  }

  .callout-warning {
    background-color: rgba(255, 153, 0, 0.05);
    border-left-color: #ff9900;
  }

  .callout-warning .callout-title {
    color: #ff9900;
  }

  .callout-caution {
    background-color: rgba(255, 51, 51, 0.05);
    border-left-color: #ff3333;
  }

  .callout-caution .callout-title {
    color: #ff3333;
  }
</style>
