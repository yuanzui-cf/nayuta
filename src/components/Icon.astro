---
import type { Icon as IconType } from '../types/icon';

interface Props {
  icon: IconType;
  class?: string;
}

const { icon, class: className = '' } = Astro.props;
---

{
  icon.type === 'img' && (
    <img
      src={icon.src}
      alt={icon.alt ?? ''}
      class={`icon-img ${className}`.trim()}
    />
  )
}
{
  icon.type === 'svg' &&
    (icon.raw ? (
      <Fragment set:html={icon.raw} />
    ) : (
      <img
        src={icon.url}
        alt={icon.alt ?? ''}
        class={`icon-svg ${className}`.trim()}
      />
    ))
}
{
  (icon.type === 'icon' || icon.type === 'font') && (
    <i
      class={`${icon.name || icon.class || ''} ${className}`.trim()}
      aria-hidden="true"
    />
  )
}
