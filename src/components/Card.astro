---
interface Props {
  href?: string;
  class?: string;
  target?: string;
}

const { href, class: className = '', ...props } = Astro.props;
const Element = href ? 'a' : 'div';
---

<Element href={href} class={`card ${className}`.trim()} {...props}>
  <slot />
</Element>

<style>
  .card {
    background-color: var(--ny-color-surface);
    border: 1px solid var(--ny-color-border);
    border-radius: var(--ny-radius-md);
  }
</style>
