---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`table-container ${className}`.trim()}>
  <slot />
</div>

<style>
  .table-container {
    overflow-x: auto;
    width: 100%;
    margin: var(--ny-space-5) 0;
    border: 1px solid var(--ny-color-border);
    border-radius: var(--ny-radius-md);
    background-color: var(--ny-color-surface);
    -webkit-overflow-scrolling: touch;
  }
</style>
