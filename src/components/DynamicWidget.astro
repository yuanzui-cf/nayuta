---
import TagCloud from '../widgets/TagCloud.astro';
import Categories from '../widgets/Categories.astro';
import RecentPosts from '../widgets/RecentPosts.astro';
import WebsiteStatus from '../widgets/WebsiteStatus.astro';
import SearchWidget from '../widgets/SearchWidget.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
---

{name === 'tag-cloud' && <TagCloud />}
{name === 'categories' && <Categories />}
{name === 'recent-posts' && <RecentPosts />}
{name === 'website-status' && <WebsiteStatus />}
{name === 'search' && <SearchWidget />}
