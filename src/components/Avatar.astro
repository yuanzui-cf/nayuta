---
interface Props {
  src: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className = 'avatar' } = Astro.props;
---

<img class={className} src={src} alt={alt} />

<style>
  .avatar {
    width: 64px;
    height: 64px;
    border-radius: var(--ny-radius-md);
    object-fit: cover;
    border: 1px solid var(--ny-color-border);
    background-color: var(--ny-color-surface-container);
  }
</style>
