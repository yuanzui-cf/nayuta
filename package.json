{
  "name": "nayuta-theme",
  "type": "module",
  "version": "0.2.0",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc -p tsconfig.json --noEmit && bun run --cwd packages/nayuta-cli check",
    "cli": "bun run packages/nayuta-cli/src/index.ts",
    "build:cli": "bun run --cwd packages/nayuta-cli build",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "^7.3.3",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@mdx-js/mdx": "3.1.1",
    "@types/bun": "^1.4.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
