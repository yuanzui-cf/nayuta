{
  "name": "nayuta-cli",
  "version": "0.1.0",
  "description": "Create and manage Nayuta blogs from the command line or terminal UI",
  "type": "module",
  "license": "MIT",
  "bin": {
    "nayuta": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuanzui-cf/nayuta.git",
    "directory": "packages/nayuta-cli"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "check": "bun x --no-install tsc --noEmit -p tsconfig.json",
    "test": "bun test tests",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opentui/core": "0.5.14",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "github-slugger": "^2.0.0",
    "typescript": "^6.0.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
